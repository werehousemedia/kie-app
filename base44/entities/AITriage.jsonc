{
  "name": "AITriage",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "plumbing",
        "heating",
        "electricity",
        "rent query",
        "compliance",
        "general",
        "noise",
        "security"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ]
    },
    "suggested_reply": {
      "type": "string"
    },
    "troubleshooting": {
      "type": "string"
    },
    "equipment_context": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "maintenance_ticket_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "conversation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
