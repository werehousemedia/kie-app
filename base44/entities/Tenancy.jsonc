{
  "name": "Tenancy",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional. UK fixed-term tenancies ceased 1 May 2026; periodic tenancies have no end date."
    },
    "rent_amount": {
      "type": "number"
    },
    "deposit_amount": {
      "type": "number"
    },
    "deposit_scheme": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Periodic",
        "Ended",
        "Upcoming"
      ],
      "default": "Active"
    },
    "rent_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "[{date: 'YYYY-MM-DD', amount: number}] — appended when rent changes"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "tenant_id",
    "property_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
