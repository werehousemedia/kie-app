{
  "name": "ComplianceRecord",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Gas Safety Certificate",
        "EPC",
        "EICR",
        "Boiler service",
        "Smoke/CO alarm",
        "HMO licence",
        "Insurance",
        "Tenancy agreement",
        "Inventory",
        "Legionella Risk Assessment",
        "PAT Test",
        "Deposit Protection Certificate"
      ]
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Compliant",
        "Expiring soon",
        "Overdue",
        "Missing"
      ],
      "default": "Compliant"
    },
    "provider": {
      "type": "string",
      "description": "Provider or engineer, e.g. SafeGas Ltd"
    },
    "file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "property_id",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
