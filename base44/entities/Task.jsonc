{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Maintenance",
        "Compliance",
        "Rent",
        "Contractor",
        "General"
      ],
      "default": "General",
      "description": "What kind of work this is \u2014 drives the kind-of-thing colour taxonomy."
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "In progress",
        "Done"
      ],
      "default": "Open"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property."
    },
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant (optional \u2014 relevant for rent/enquiry tasks)."
    },
    "contractor_id": {
      "type": "string",
      "description": "Reference to Contractor (optional \u2014 set when a contractor is booked)."
    },
    "source": {
      "type": "string",
      "default": "manual",
      "description": "Where the task came from: manual, auto:maintenance, auto:compliance, auto:rent, auto:enquiry, compliance_page."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "MaintenanceTicket",
        "ComplianceRecord",
        "Bill",
        "Conversation",
        "ShortLetBooking",
        "Manual"
      ],
      "default": "Manual",
      "description": "Entity type of the record that spawned this task (back-reference)."
    },
    "source_id": {
      "type": "string",
      "description": "ID of the record that spawned this task (back-reference)."
    },
    "source_key": {
      "type": "string",
      "description": "Idempotency key for auto-created tasks, e.g. maintenance:<ticket_id>. The task engine never creates two tasks with the same key."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category",
    "property_id"
  ]
}