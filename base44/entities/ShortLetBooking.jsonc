{
  "name": "ShortLetBooking",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Airbnb",
        "Booking.com",
        "Direct",
        "Other"
      ],
      "default": "Airbnb"
    },
    "guest_name": {
      "type": "string"
    },
    "guests_count": {
      "type": "number"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "nightly_rate": {
      "type": "number"
    },
    "total_payout": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Confirmed",
        "Checked in",
        "Checked out",
        "Cleaned",
        "Cancelled"
      ],
      "default": "Confirmed"
    },
    "cleaning_ticket_id": {
      "type": "string",
      "description": "MaintenanceTicket booked for the post-checkout turnaround clean"
    },
    "external_id": {
      "type": "string",
      "description": "iCal UID for imported bookings — dedupe key"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "property_id",
    "check_in",
    "check_out"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
