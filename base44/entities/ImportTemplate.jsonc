{
  "name": "ImportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "sheet_url",
        "file"
      ],
      "default": "sheet_url"
    },
    "tab_mappings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "sheet_url": {
      "type": "string"
    },
    "sync_secret": {
      "type": "string",
      "description": "Shared secret for unattended sync calls"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "tab_mappings"
  ]
}