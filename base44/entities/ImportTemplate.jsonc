{
  "name": "ImportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "sheet_url",
        "file"
      ],
      "default": "sheet_url"
    },
    "tab_mappings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "sheet_url": {
      "type": "string"
    },
    "sync_secret": {
      "type": "string",
      "description": "Shared secret for unattended sync calls"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "name",
    "tab_mappings"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
