{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Boiler",
        "Heating",
        "Electrical",
        "Appliance",
        "Plumbing",
        "Security",
        "Furniture",
        "Other"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Heating & boiler",
        "Appliance",
        "Furniture",
        "Electronics",
        "Kitchen",
        "Garden",
        "Safety & security",
        "Other"
      ]
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "Gas",
        "Electric",
        "Oil",
        "LPG",
        "Heat pump",
        "Other"
      ]
    },
    "install_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "current_value": {
      "type": "number"
    },
    "supplier": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Good",
        "Fair",
        "Worn",
        "Needs replacing"
      ]
    },
    "replacement_due": {
      "type": "string",
      "format": "date"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "next_service_due": {
      "type": "string",
      "format": "date"
    },
    "warranty_info": {
      "type": "string"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string",
      "description": "Where in the property, e.g. Kitchen cupboard"
    },
    "photo_url": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "service_history": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    }
  },
  "required": [
    "property_id",
    "type"
  ]
}