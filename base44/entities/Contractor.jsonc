{
  "name": "Contractor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "trade": {
      "type": "string",
      "enum": [
        "Plumbing",
        "Heating/Gas",
        "Electrical",
        "General",
        "Carpentry",
        "Roofing",
        "Pest control",
        "Cleaning",
        "Locksmith",
        "Appliance repair"
      ]
    },
    "services": {
      "type": "string"
    },
    "accreditations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Professional accreditations, e.g. Gas Safe, NICEIC, DEA, TrustMark. Drives contractor ranking for compliance jobs."
    },
    "coverage_area": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "Available",
        "Limited",
        "Booked",
        "On holiday"
      ]
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date"
    },
    "rating": {
      "type": "number"
    },
    "preferred": {
      "type": "boolean",
      "default": false
    },
    "avg_quote": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "name",
    "trade"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
