{
  "name": "IntegrationLog",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "enum": [
        "Google Sheets",
        "Google Drive",
        "WhatsApp",
        "KIE Lettings",
        "KIE Sales",
        "Bank/Payment"
      ]
    },
    "event": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "default": "success"
    },
    "details": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "service",
    "event"
  ]
}
