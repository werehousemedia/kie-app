{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Rent received",
        "Bill paid",
        "Contractor payment",
        "Expense",
        "Subscription",
        "Refund",
        "Other"
      ]
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Completed",
        "Pending",
        "Failed"
      ],
      "default": "Completed"
    },
    "notes": {
      "type": "string"
    },
    "simulated": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "type",
    "amount",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
