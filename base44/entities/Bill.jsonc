{
  "name": "Bill",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Rent",
        "Council tax",
        "Gas",
        "Electricity",
        "Water",
        "Internet",
        "Service charge",
        "Insurance",
        "Subscription",
        "Contractor invoice",
        "Maintenance",
        "Other"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Paid",
        "Due",
        "Overdue",
        "Scheduled"
      ],
      "default": "Due"
    },
    "payment_method": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "is_income": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "category",
    "due_date",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
