{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "tenancy_start": {
      "type": "string",
      "format": "date"
    },
    "tenancy_end": {
      "type": "string",
      "format": "date"
    },
    "rent_amount": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Paid",
        "Due",
        "Overdue",
        "Part-paid"
      ]
    },
    "notes": {
      "type": "string"
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "Granted",
        "Pending",
        "Withdrawn"
      ]
    },
    "data_retention": {
      "type": "string"
    },
    "deposit_scheme": {
      "type": "string",
      "description": "e.g. DPS, TDS, mydeposits"
    },
    "deposit_amount": {
      "type": "number"
    },
    "photo_url": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "name",
    "phone",
    "property_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "data.is_demo": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_id": "{{user.data.workspace_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
