{
  "name": "Property",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "House",
        "Flat",
        "HMO",
        "Bungalow",
        "Studio",
        "Maisonette",
        "Commercial"
      ]
    },
    "tenure": {
      "type": "string",
      "enum": [
        "Freehold",
        "Leasehold",
        "Commonhold"
      ],
      "description": "Ownership tenure — required for PRS Database registration."
    },
    "hmo_status": {
      "type": "string",
      "enum": [
        "Not HMO",
        "Licensed HMO",
        "HMO (unlicensed)"
      ]
    },
    "units_count": {
      "type": "number"
    },
    "occupancy_status": {
      "type": "string",
      "enum": [
        "Fully occupied",
        "Partially occupied",
        "Vacant",
        "Void"
      ]
    },
    "photo_url": {
      "type": "string"
    },
    "purchase_value": {
      "type": "number"
    },
    "monthly_rent_expected": {
      "type": "number"
    },
    "council_tax_band": {
      "type": "string"
    },
    "is_short_let": {
      "type": "boolean",
      "default": false,
      "description": "Listed on Airbnb/Booking.com — enables short-let automations. App-owned, never synced from sheet."
    },
    "cleaning_contractor_id": {
      "type": "string",
      "description": "Preferred cleaning contractor for turnaround cleans. App-owned."
    },
    "airbnb_ical_url": {
      "type": "string",
      "description": "Airbnb listing iCal export URL. App-owned."
    },
    "booking_ical_url": {
      "type": "string",
      "description": "Booking.com listing iCal export URL. App-owned."
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace this record belongs to. Row-level security scopes reads and writes to the user's workspace."
    }
  },
  "required": [
    "name",
    "address"
  ]
}
